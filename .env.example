# Copie para .env e preencha. No Coolify/painel, cadastre estas variáveis no próprio painel.

# Servidor
PORT=3000
NODE_ENV=production
DEBUG=FALSE

# Nome mostrado no app
SITE_TITLE=MeuTerminal

# Endereço onde você abre o app (ex.: https://terminal.seudominio.com)
BASE_URL=http://localhost:3000

# Login com email e senha (recomendado). Quando os dois estão preenchidos,
# substituem o PIN abaixo. Troque a senha para desconectar todos os dispositivos.
AUTH_EMAIL=
AUTH_PASSWORD=

# Verificação em duas etapas (opcional, só com email e senha): código do app
# autenticador. Gere com "npm run 2fa" e cole aqui. Vazio = desligada.
# Passo a passo: abra /guia no app.
AUTH_TOTP_SECRET=

# PIN (usado apenas se AUTH_EMAIL/AUTH_PASSWORD estiverem vazios)
MEUTERMINAL_PIN=

# Minutos bloqueado depois de 5 logins errados (padrão: 15)
LOCKOUT_TIME=

# Horas que um login dura (padrão: 24)
# MAX_SESSION_AGE=24

# Origens permitidas, separadas por vírgula (vazio = todas)
ALLOWED_ORIGINS=

# Banco do app (abas, comandos rápidos, favoritos). Padrão: ./data/meuterminal.db
# No Docker fica em /app/data: monte essa pasta como volume para não perder as abas no deploy.
# DB_PATH=/app/data/meuterminal.db

# Pasta onde o gerenciador de arquivos abre (padrão: a home, /root no Docker)
# FILES_HOME=/root

# Aba de Anotações (ligada por padrão). Use false para desligar.
# NOTES_ENABLED=false

# Pasta onde as anotações ficam salvas: um arquivo .md por nota (estilo Obsidian), título = nome
# do arquivo. Padrão: ~/.meuterminal/notes (no Docker, o volume da home /root, que sobrevive aos
# deploys). Anotações que estavam na pasta antiga (ao lado do DB_PATH) são copiadas na 1ª subida.
# NOTES_DIR=/root/.meuterminal/notes

# Webhooks que rodam um script no servidor (desligado por padrão - veja /admin → Webhooks).
# WEBHOOKS_ENABLED=true

# Chave para cifrar o segredo HMAC dos webhooks (só necessário se usar assinatura HMAC em vez de
# token). Gere uma vez com: openssl rand -hex 32
# WEBHOOK_SECRET_KEY=

# Modo demonstração: terminal simulado, sem acesso ao servidor
# DEMO_MODE=true

# Vibecoding "Publicar": token da Vercel para publicar o projeto com um clique (gere um em
# vercel.com/account/tokens). Sem isso, o botão Publicar explica o que falta em vez de tentar.
# VERCEL_TOKEN=

# Só no Docker
# ENABLE_STARSHIP=true
# TZ=America/Sao_Paulo
