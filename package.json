{
  "name": "meuterminal",
  "version": "2.7.0",
  "description": "A stupidly simple web-based terminal emulator, with common tools and Starship enabled (via Docker)! 🚀",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run copy-xterm && npm run build-tiptap && node server.js",
    "dev": "npm run copy-xterm && npm run build-tiptap && nodemon server.js",
    "copy-xterm": "node scripts/copy-xterm.js",
    "build-tiptap": "node scripts/build-tiptap.js",
    "2fa": "node scripts/totp-setup.js",
    "icons": "node scripts/build-icons.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xterm/addon-attach": "^0.11.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-ligatures": "^0.9.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "tiptap-markdown": "^0.9.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-static": "^1.49.0",
    "nodemon": "^3.1.10"
  }
}
